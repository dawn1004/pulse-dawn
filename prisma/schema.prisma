// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Presence {
  id          String   @id // client-generated session uuid
  lat         Float // ALREADY privacy-offset coords (raw is never stored)
  lng         Float
  busy        Boolean  @default(false) // true while in an active connection
  lastSeen    DateTime
  nickname    String
  aboutMe     String   @default("")
  avatar      String // mood id
  tags        String[]
  fingerprint String? // device fingerprint for moderation

  @@index([lastSeen])
}

// Durable moderation state keyed by device fingerprint.
model DeviceModeration {
  fingerprint  String    @id
  reportCount  Int       @default(0)
  bannedUntil  DateTime?
  permanentBan Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// Audit log of user reports. One report per reporter session per reported peer.
model UserReport {
  id                  String   @id @default(uuid())
  reporterSessionId   String
  reportedSessionId   String
  reportedFingerprint String
  reason              String
  details             String?
  createdAt           DateTime @default(now())

  @@unique([reporterSessionId, reportedSessionId])
  @@index([reportedFingerprint])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
